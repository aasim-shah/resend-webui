# ==========================================
# RESEND WEBUI ENVIRONMENT CONFIGURATION
# ==========================================

# Account 1: Primary Account (Default)
RESEND_API_KEY=re_123456789_your_primary_api_key_here
FROM_EMAIL=contact@yourdomain.com
FROM_NAME="Primary Account"

# Additional Account Configurations (Optional)
# Create additional .env files like .env.secondary to manage multiple profiles:
# RESEND_API_KEY=re_987654321_your_secondary_api_key_here
# FROM_EMAIL=sales@secondarydomain.com
# FROM_NAME="Secondary Account"

# resend-webui-api backend — this frontend talks to it directly from the
# browser for auth, sender profiles, emails, domains, and analytics.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
